# 루트의 .env 하나만 쓴다 — 앱(web/office)과 db 스크립트가 모두 이 파일을 읽는다.
#   cp .env.example .env   # 로컬 docker 기준값이라 그대로 복사하면 바로 동작한다

# ── 필수 ─────────────────────────────────────────────────────────────────────
# Postgres 커넥션 스트링. 아래 기본값은 docker-compose.yml과 일치한다(호스트 포트 5433).
# 배포(Neon)에서는 반드시 **풀드(pooled)** 커넥션 스트링을 쓴다 — 서버리스에서 커넥션이 고갈된다.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/theta

# 통합 테스트용 접속 정보. 실제 DB 이름은 vitest 프로젝트마다 갈라지고(theta_test_web 등)
# 처음 쓸 때 자동으로 만들어진다 — 프로젝트들이 병렬로 돌면서 서로의 테이블을 비우지 않도록.
# 테스트는 매 파일마다 테이블을 truncate하므로 개발용 DB(theta)와 반드시 분리한다.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/theta_test

# 세션 쿠키/오피스 admin 토큰 서명 키. 아무 랜덤 문자열이면 되고, 만드는 법:
#   openssl rand -base64 32
# 값이 바뀌면 기존 로그인 세션이 전부 무효가 된다.
SESSION_SECRET=dev-only-insecure-secret-change-me

# 오피스(:3001) 접근 비밀번호. 배포된 오피스가 무방비로 열리는 것을 막는 최소 장치다.
# 미설정이면 오피스는 로그인 화면에서 더 진행되지 않는다.
ADMIN_PASSWORD=theta-office

# ── 선택 ─────────────────────────────────────────────────────────────────────
# Google 로그인. **비워 두면 로그인 화면에서 "Google로 계속하기" 버튼이 자동으로 숨겨지고**
# 이메일 가입 + 데모 계정 원클릭만으로 모든 기능이 동작한다.
# 발급 방법은 docs/setup-google-oauth.md 참고 (콘솔에 등록할 redirect URI:
#   http://localhost:3000/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
